// AfroRush — Firestore Security Rules
// =============================================================================
// Copy this entire file's contents into:
//   Firebase Console → Firestore Database → Rules → Publish
//
// These rules:
//   1. Allow anyone to read the public data (crews, presence, leaderboard users).
//   2. Require auth for writes.
//   3. Allow a user to fully manage their own profile + presence doc.
//   4. Allow anyone (signed in) to create/join crews.
// =============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Users (player profiles) ----------
    // Anyone can read profiles (for leaderboards). Only the owner can write.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Sub-collection: per-user metadata (e.g. unlocked items)
      match /meta/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ---------- Crews ----------
    // Anyone can read crews (for the crews list). Any signed-in user can
    // create / update / join / leave crews.
    match /crews/{crewId} {
      allow read: if true;
      allow create: if request.auth != null;
      // Allow updates (memberCount, totalRep) by any signed-in user.
      allow update: if request.auth != null;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerId;
    }

    // ---------- Presence ----------
    // Anyone can read presence (online player list). A signed-in user can only
    // write their own presence doc.
    match /presence/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
