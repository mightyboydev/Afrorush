// AfroRush — Firestore Security Rules (client-side admin panel version)
// Paste into: Firebase Console → Firestore Database → Rules → Publish
//
// Players can only edit safe profile fields. Money, rep, bans, warnings and
// roles can only be changed by staff (the owner, users whose profile role is
// admin/moderator, or anyone with a document in /admins). Only the owner can
// change roles.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner() {
      return isSignedIn() && request.auth.uid == '1rf7yswl35QuUyfdQehMs1qdlIy2';
    }
    function isStaff() {
      return isSignedIn() && (
        isOwner()
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'player')
               in ['admin', 'moderator', 'owner'])
      );
    }

    // ---------- Users ----------
    match /users/{uid} {
      allow read: if true;

      // New profile: fixed starting balances, never a privileged role.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.cash == 500
        && request.resource.data.gold == 50
        && request.resource.data.rep == 0
        && request.resource.data.banned == false
        && (!('role' in request.resource.data) || request.resource.data.role == 'player');

      allow update: if
        // Player: safe fields only
        (isSignedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'username', 'avatar', 'city', 'loadout', 'soundOn',
              'graphicsQuality', 'lastSeen', 'onboardingComplete', 'photoURL'
            ]))
        // Owner: anything (including roles)
        || isOwner()
        // Other staff: anything except the role field
        || (isStaff() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));

      allow delete: if false;

      match /private/{docId} {
        allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
        allow write: if isSignedIn() && request.auth.uid == uid;
      }

      // Notifications: staff create (warnings), owner of the inbox reads/marks read.
      match /notifications/{notifId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create: if isStaff();
        allow update: if isSignedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if false;
      }

      // Unlocked items: owner seeds defaults once; staff manage after that.
      match /meta/{docId} {
        allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
        allow create: if (isSignedIn() && request.auth.uid == uid
            && request.resource.data.ids == ['bike-spark', 'outfit-street', 'stk-none', 'horn-beep', 'exh-stock'])
          || isStaff();
        allow update, delete: if isStaff();
      }
    }

    // ---------- Crews ----------
    match /crews/{crewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isStaff());
    }

    // ---------- Presence ----------
    match /presence/{uid} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // ---------- Admins ----------
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow write: if isOwner();
    }

    // ---------- Admin logs (append-only) ----------
    match /adminLogs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // ---------- Global settings ----------
    match /settings/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ---------- Direct Messages (DMs) ----------
    // Players can read messages they sent or received, and create new ones
    // where they are the sender. Editing/deleting is blocked.
    match /dm_chats/{msgId} {
      allow read: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.toUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // ---------- Multiplayer Race Rooms ----------
    // Serverless multiplayer: each room is one Firestore document. Room codes
    // are shared peer-to-peer, so anyone signed in can read/join. Writes are
    // permissive (any signed-in user can update) — the worst an attacker can
    // do is grief a room they joined, which the host can mitigate by starting
    // the race. For stricter rules use FieldTransform / Cloud Functions.
    match /race_rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.host_uid == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if false;
    }
  }
}
