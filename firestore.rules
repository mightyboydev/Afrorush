// AfroRush — Firestore Security Rules (Phase 4 — locked down)
// =============================================================================
// Copy this entire file's contents into:
//   Firebase Console → Firestore Database → Rules → Publish
//
// CRITICAL: Players can NOT edit their own cash, gold, rep, role, bans or
// warnings from the browser. All money/reward/purchase/ban changes must go
// through server routes (src/app/api/admin/*) using the Firebase Admin SDK.
// =============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Users (public profile) ----------
    // Anyone can read public fields. Only the owner can write,
    // and only the SAFE fields (avatar, username, city, loadout, soundOn,
    // graphicsQuality, lastSeen, onboardingComplete).
    // Money, rep, banned, warnings, etc. are server-written only.
    match /users/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'username', 'avatar', 'city', 'loadout', 'soundOn',
            'graphicsQuality', 'lastSeen', 'onboardingComplete', 'photoURL'
          ]);

      // Private subcollection (email, device info, etc.)
      match /private/{docId} {
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // Notifications — owner can read & mark as read. Server writes only.
      match /notifications/{notifId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }

      // Meta subcollection (unlocked items) — owner can read.
      // Writes go through server (purchaseItem API).
      match /meta/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ---------- Crews ----------
    // Anyone can read crews. Crew owner can update/delete.
    // Any signed-in user can create a crew.
    match /crews/{crewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // ---------- Presence ----------
    // Anyone can read presence. Owner can write only their own doc.
    match /presence/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- Admins ----------
    // Only admins can read the admins collection. Only owners can write.
    match /admins/{uid} {
      allow read: if request.auth != null && isAdmin();
      allow write: if request.auth != null && isOwner();
    }

    // ---------- Admin Logs (immutable) ----------
    // Admins can read. No one can write or delete (server SDK bypasses rules).
    match /adminLogs/{logId} {
      allow read: if request.auth != null && isAdmin();
      allow write, delete: if false;
    }

    // ---------- Global settings ----------
    // Anyone can read. Only admins can write.
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    // ---------- Helper functions ----------
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    function isOwner() {
      return request.auth != null && request.auth.token.role == "owner";
    }
  }
}
