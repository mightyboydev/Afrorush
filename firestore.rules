// AfroRush — Firestore Security Rules (no env vars needed)
// =============================================================================
// Copy this entire file's contents into:
//   Firebase Console → Firestore Database → Rules → Publish
//
// This version works WITHOUT the Firebase Admin SDK. Admin actions go through
// client-side Firestore writes, and these rules allow admin users to modify
// any user document. The owner UID is hard-coded below.
// =============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Hard-coded owner (full access to everything) ----------
    // This UID is the project owner. They can read/write ANY document.
    function isOwner() {
      return request.auth != null && request.auth.uid == '1rf7yswl35QuUyfdQehMs1qdlIy2';
    }

    // Check if the current user has an admin doc with a valid role.
    // Uses get() — costs 1 read per check but enables no-env-var admin.
    function isAdmin() {
      return isOwner()
        || (
          request.auth != null
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['owner', 'admin', 'moderator']
        );
    }
    function isOwnerRole() {
      return isOwner()
        || (
          request.auth != null
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner'
        );
    }

    // ---------- Users (public profile) ----------
    // Anyone can read public fields. The owner can edit safe fields on their
    // own doc. Admins can edit ANY field on ANY user doc (cash, rep, bans, etc.).
    match /users/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if isAdmin()
        || (
          request.auth != null && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'username', 'avatar', 'city', 'loadout', 'soundOn',
              'graphicsQuality', 'lastSeen', 'onboardingComplete', 'photoURL'
            ])
        );
      allow delete: if isAdmin();

      // Private subcollection (email, device info, etc.)
      match /private/{docId} {
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
        allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
      }

      // Notifications — owner can read & mark as read. Admins can create.
      match /notifications/{notifId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow update: if request.auth != null && (request.auth.uid == uid || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create: if isAdmin();
        allow delete: if isAdmin();
      }

      // Meta subcollection (unlocked items)
      match /meta/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
      }
    }

    // ---------- Crews ----------
    match /crews/{crewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin()
        || (request.auth != null && resource.data.ownerId == request.auth.uid);
    }

    // ---------- Presence ----------
    match /presence/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- Admins ----------
    // Admins can read the list. Only the owner can add/remove admins.
    match /admins/{uid} {
      allow read: if isAdmin();
      allow create, update, delete: if isOwner();
    }

    // ---------- Admin Logs (immutable) ----------
    // Admins can read. Anyone (via client SDK with admin check in code) can create.
    // No one can delete or edit.
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ---------- Global settings ----------
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
